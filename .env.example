# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session & Settings Encryption Secret (auto-generated fallback if omitted in local dev)
SESSION_SECRET=""
ADMIN_SESSION_SECRET=""

# Initial Super Admin Credentials (bootstrapped on startup if user doesn't exist; never hardcode in source)
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Razorpay Backend Credentials (also editable securely in Super Admin > Razorpay Gateway /admin/settings/payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Admin Bootstrap Emails (comma-separated list of Google sign-in emails granted Super Admin)
ADMIN_EMAILS="info.nexustekfusion@gmail.com,info@nexustekfusion.in"

# Outbound Email Delivery (Optional - configure Resend or HTTP webhook; falls back to audit log when blank)
RESEND_API_KEY=""
EMAIL_WEBHOOK_URL=""
EMAIL_FROM="NexusTekFusion <info@nexustekfusion.in>"

# Outbound Mobile SMS OTP Provider (Optional - configure Twilio or MSG91; returns dev preview if blank)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Optional External 3D Slicing & CAD Conversion Executables
SLICER_BIN_PATH=""
CAD_CONVERTER_CMD=""
